# Copy to .env and fill in. Never commit .env: anyone with the calendar URLs can read all your events.
# Load with:  set -a; . ./.env; set +a

# Calendars, separated by spaces, in quotes (https://, webcal:// or file://)
ICS_URLS="https://calendar.google.com/calendar/ical/YOUR-ID/private-SECRET/basic.ics file:///path/to/wallKalender/teams.ics"
# Names in the "Kalender" menu, same order as ICS_URLS (otherwise taken from the calendar)
# ICS_NAMES="Privat Teams"

# Optional
# PORT=8080
# TZ=Europe/Berlin
# DEVICE_REFRESH_URL=http://e-ink-display.local/refresh   # receives a POST on every view change
# DARK=1   # start in dark mode
# THEME_CSS=/path/to/theme.css   # own colors, e.g. .dark{--bg:#1e1e2e;--fg:#cdd6f4}
# TERMINE=/path/to/termine.txt   # monthly events, e.g. "4.AT 09:00 Reisekosten abrechnen"

# Only for teams_ics.py (Teams calendar via teams-for-linux); percent-encode special characters in the password
# TEAMS_MQTT=mqtt://user:password@mqtt-broker.local:1883
# TEAMS_ICS=teams.ics
# TEAMS_TOPIC=teams   # topicPrefix from the teams-for-linux MQTT config
